# =============================================================================
# minimax-video-factory — central configuration (.env)
# Copy to .env and adjust. All paths may be relative to the repo root or absolute.
# Every script + the Docker stack read this file (see scripts/config.sh).
# =============================================================================

# -----------------------------------------------------------------------------
# HOST PATHS (disk space matters: models ≈ 32 GB for INT4, up to ~90 GB for bf16)
# -----------------------------------------------------------------------------
# Project root (absolute) — used by docker compose for the /workspace mount.
PROJECT_ROOT=/path/to/minimax-video-factory

# Where the model weights are downloaded & mounted from. Put it on your biggest
# partition. Used by download_models.sh and mounted read-only into the container.
MODELS_DIR=/opt/minimax/models

# Where generated .mp4 land (mounted into the container as its output dir).
OUTPUT_DIR=/path/to/minimax-video-factory/output

# Optional host dir for I2V/R2V reference media (mounted into ComfyUI /input).
INPUT_DIR=/path/to/minimax-video-factory/input

# Studio downloads dir (mounted into the container as /downloads, writable).
DOWNLOADS_DIR=/path/to/minimax-video-factory/downloads

# Persistent HuggingFace cache (whisper models) — survives container recreates.
HF_CACHE_DIR=/path/to/minimax-video-factory/.hf-cache

# -----------------------------------------------------------------------------
# OUTPUT NAMING
# -----------------------------------------------------------------------------
# Default filename_prefix pattern for generated clips (relative to OUTPUT_DIR).
# The ComfyUI SaveVideo node appends "_NNNNN_.mp4". Per-scene submissions can
# override this. Examples: "video/factory", "renders/aurora", "scenes/%Y%m%d"
OUTPUT_PREFIX=video/factory

# -----------------------------------------------------------------------------
# MODEL SET
# -----------------------------------------------------------------------------
# Default variant is INT4 pruned (fits 12 GB VRAM). To use a bigger model set,
# uncomment the matching group below AND bump the *_BYTES so download_models.sh
# validates sizes (leave *_BYTES empty to skip size checks).
#
#   INT4 (default, 12 GB VRAM):
MODEL_DIFFUSION=minimax_h3_fl2va_pruned_int4_convrot.safetensors
MODEL_TEXT_ENCODER=qwen3vl_32b_minimax_h3_int4_convrot.safetensors
MODEL_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
MODEL_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
MODEL_DIFFUSION_BYTES=11337536776
MODEL_TEXT_ENCODER_BYTES=14952506624
MODEL_VIDEO_VAE_BYTES=5207808496
MODEL_AUDIO_VAE_BYTES=605254808
#
#   FP8_SCALED (24 GB+ VRAM; drop --lowvram from COMFYUI_EXTRA_ARGS):
# MODEL_DIFFUSION=minimax_h3_fl2va_pruned_fp8_scaled.safetensors
# MODEL_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
# MODEL_DIFFUSION_BYTES=20958205608
# MODEL_TEXT_ENCODER_BYTES=15687142551
#
#   BF16 (48 GB+ VRAM):
# MODEL_DIFFUSION=minimax_h3_fl2va_pruned_bf16.safetensors
# MODEL_TEXT_ENCODER=qwen3vl_32b_minimax_h3_bf16.safetensors
# MODEL_DIFFUSION_BYTES=40225724176
# MODEL_TEXT_ENCODER_BYTES=51506295256

# Where the INT4 pruned weights come from (diffusion + text encoder). The VAEs
# always come from Comfy-Org/MiniMax-H3 (note the vae/ subfolder in URLs).
# --- model variants ---------------------------------------------------------
# Measured on this repo's 12 GB card: the INT4 set below is what fits without
# help. ComfyUI runs with --lowvram and streams layers from RAM, so heavier
# weights are slower rather than impossible -- the 15 GB text encoder plus the
# 11 GB diffusion model already exceed 12 GB today and work.
#
#   diffusion (Comfy-Org/MiniMax-H3, under diffusion_models/)
#     minimax_h3_fl2va_pruned_int4_convrot   11.3 GB   default, most aggressive
#     minimax_h3_fl2va_pruned_int8_convrot   21.0 GB   better fidelity, slower
#     minimax_h3_fl2va_pruned_fp8_scaled     21.0 GB   needs 24 GB to skip --lowvram
#     minimax_h3_fl2va_pruned_bf16           40.2 GB   out of reach here
#
#   text encoder (Comfy-Org/MiniMax-H3, under text_encoders/)
#     qwen3vl_32b_minimax_h3_int4_convrot    15.0 GB   default
#     qwen3vl_32b_minimax_h3_nvfp4_awq       15.7 GB   what the official ComfyUI
#                                                      template uses; same size
#     qwen3vl_32b_minimax_h3_int8_convrot    27.1 GB
#
# To switch, set the filename AND where it comes from. The two repos are laid
# out differently, which is why the path is separate from the name:
#   MODEL_DIFFUSION=minimax_h3_fl2va_pruned_int8_convrot.safetensors
#   MODEL_DIFFUSION_REPO=Comfy-Org/MiniMax-H3
#   MODEL_DIFFUSION_PATH=diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors
MODEL_REPO_INT4=Merserk/MiniMax-H3-INT4-ConvRot
MODEL_REPO_COMFY=Comfy-Org/MiniMax-H3

# -----------------------------------------------------------------------------
# COMFYUI / RENDER
# -----------------------------------------------------------------------------
# ComfyUI git tag to build. Only bump with care (0.30.x has native H3 support).
COMFYUI_TAG=v0.30.2

# Host port the ComfyUI API is published on (127.0.0.1 only).
COMFYUI_PORT=8188

# Extra ComfyUI CLI flags. --lowvram is required on 12 GB VRAM with torch>=2.8
# DynamicVRAM; keep --fast-disk on 16-32 GB RAM machines.
COMFYUI_EXTRA_ARGS=--lowvram --fast-disk --disable-pinned-memory

# -----------------------------------------------------------------------------
# CONTAINER IDENTITY
# -----------------------------------------------------------------------------
# Image built locally (or pulled from a registry) and the container name.
COMFY_IMAGE=minimax-comfyui:local
COMFY_CONTAINER=minimax-comfyui

# Docker Hub publishing (for `./scripts/publish_image.sh`):
DOCKER_HUB_USER=leodg
DOCKER_HUB_REPO=minimax-video-factory

# -----------------------------------------------------------------------------
# MCP SERVER (path to the API workflow JSON; the .mp4 output naming above)
# -----------------------------------------------------------------------------
# Path to the API-format workflow the MCP server submits. Leave default.
WORKFLOW_PATH=${PROJECT_ROOT}/workflows/minimax_h3_t2v_api.json

# -----------------------------------------------------------------------------
# REMOTE MCP (VPS / HTTPS access)
# -----------------------------------------------------------------------------
# Transport the MCP server listens on when run via mcp_http_runner.sh or a
# reverse proxy. stdio = local (docker exec). streamable-http = expose on MCP_PORT.
#   stdio | http | streamable-http | sse
# streamable-http is for the REMOTE variant. Running src/minimax_mcp/server.py
# directly with this inherited starts an HTTP server, so an stdio client waits
# for a peer that never speaks and reports only "Connection closed" -- with no
# hint as to why. Force stdio when driving the server over a pipe:
#   MCP_TRANSPORT=stdio uv run python src/minimax_mcp/server.py
MCP_TRANSPORT=streamable-http
# Bind interface + port for the HTTP MCP server (inside the container).
MCP_HOST=0.0.0.0
MCP_PORT=8848

# -----------------------------------------------------------------------------
# KNOWLEDGE BASE (Postgres + pgvector, local LLM, optional Obsidian export)
# -----------------------------------------------------------------------------
KB_POSTGRES_USER=kb
KB_POSTGRES_PASSWORD=kb
KB_POSTGRES_DB=knowledge
KB_POSTGRES_PORT=5432
KB_POSTGRES_CONTAINER=minimax-kb-postgres
KB_POSTGRES_DATA_DIR=/path/to/minimax-video-factory/.pgdata
# SQLAlchemy connection string (psycopg3 driver). Must match the vars above.
KB_DATABASE_URL=postgresql+psycopg://kb:kb@127.0.0.1:5432/knowledge

# Text-generation LLM: ollama (default, local/free) or openai-compatible.
# Default lfm2:24b: good balance for ~30 GB RAM. Faster local alternatives:
# qwen2.5-coder:14b (fast, ~1 min/ingest). Higher-quality but SLOW on 30 GB RAM
# (swapping; >15 min/ingest): qwen2.5:32b-instruct-q4_K_M. gpt-oss:20b is NOT
# suitable — it ignores Ollama's format=json and returns empty JSON.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=lfm2:24b
# Per-call timeout for text generation (seconds). The 32B class of models on a
# swapping 30 GB box can exceed 900s; raise this if you use those models.
LLM_TIMEOUT=900
# Only used when LLM_PROVIDER=openai-compatible (e.g. OpenRouter, Groq free tier).
OPENAI_API_URL=
OPENAI_API_KEY=

# Embeddings are ALWAYS local via Ollama, regardless of LLM_PROVIDER.
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIM=1024

# Optional: also write a human-readable markdown copy of each ingested item here.
# Leave empty to skip (the default — avoids touching the existing, possibly
# unhealthy, Obsidian vault).
VAULT_PATH=

# -----------------------------------------------------------------------------
# INSTAGRAM SAVED -> KNOWLEDGE BASE (RabbitMQ + ig-worker daemon)
# -----------------------------------------------------------------------------
# sessionid from the Chrome cookies (Instagram, logged-in). Never a password.
# Chrome 127+ encrypts the sessionid (app-bound), so it must be copied from
# DevTools -> Application -> Cookies -> instagram.com -> sessionid -> Value.
IG_SESSIONID=
# Netscape cookies.txt exported from the logged-in browser. Preferred over
# browser cookies for DOWNLOADING inside the container (no Chrome profile, and
# app-bound cookies can't be read by yt-dlp). Optional: public posts work
# without it.
IG_COOKIES_FILE=
# RabbitMQ: default local docker service; VPS = point at your RabbitMQ.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=ig.saved
IG_WORKER_CONCURRENCY=1
IG_DOWNLOADS_DIR=downloads/ig
IG_DELETE_AFTER_INGEST=true
IG_STATE_FILE=downloads/ig/state.json
# Local vision model for describing saved photos (Ollama).
OLLAMA_VISION_MODEL=qwen2.5vl:7b
